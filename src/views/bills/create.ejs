<div class="page-header">
  <h1>Tambah Tagihan</h1>

  <p>
    Dashboard / Data Tagihan / Tambah Tagihan
  </p>
</div>


<form
  id="billForm"
  action="/bills/create"
  method="POST"
  enctype="multipart/form-data"
>

  <div class="bill-create-layout">

    <!-- ================================================= -->
    <!-- KIRI : INFORMASI TAGIHAN -->
    <!-- ================================================= -->

    <div class="bill-information card">

      <h2 class="section-title">
        <i class="fa-solid fa-list-check"></i>
        Informasi Tagihan
      </h2>


      <!-- JUDUL -->

      <div class="form-group">

        <label for="title">
          Judul Tagihan
        </label>

        <input
          type="text"
          id="title"
          name="title"
          placeholder="Contoh : Listrik, Internet, Sewa Gedung"
          required
        >

      </div>


      <!-- NOMOR TAGIHAN -->

      <div class="form-group">

        <label for="invoiceNumber">
          Nomor Tagihan
        </label>

        <input
          type="text"
          id="invoiceNumber"
          name="invoiceNumber"
          placeholder="Isi Nomor Invoice yang tertera pada tagihan"
        >

      </div>


      <!-- VENDOR -->

    <div class="form-group">

        <label for="vendorName">
            Vendor
        </label>

        <input
            type="text"
            id="vendorName"
            name="vendorName"
            list="vendorList"
            placeholder="Ketik atau pilih vendor"
            autocomplete="off"
            required
        >

        <datalist id="vendorList">

            <% if (typeof vendors !== "undefined" && vendors.length > 0) { %>

                <% vendors.forEach(function(vendor) { %>

                    <option value="<%= vendor.name %>"></option>

                <% }); %>

            <% } %>

        </datalist>

    </div>


      <!-- TOTAL BIAYA -->

      <div class="form-group">

        <label for="amount">
          Total Biaya
        </label>

        <div class="amount-wrapper">

          <span class="currency">
            Rp
          </span>

          <input
            type="number"
            id="amount"
            name="amount"
            min="0"
            step="0.01"
            placeholder="Masukkan Total Tagihan"
            required
          >

        </div>

        <small>
          Masukkan total keseluruhan nilai tagihan.
        </small>

      </div>


      <!-- TANGGAL -->

      <div class="date-row">

        <div class="form-group">

          <label for="invoiceDate">
            Tanggal Tagihan
          </label>

          <input
            type="date"
            id="invoiceDate"
            name="invoiceDate"
            required
          >

        </div>


        <div class="form-group">

          <label for="dueDate">
            Tenggat Tagihan (Deadline)
          </label>

          <input
            type="date"
            id="dueDate"
            name="dueDate"
            required
          >

        </div>

      </div>


      <!-- ================================================= -->
      <!-- TAGIHAN BERULANG -->
      <!-- ================================================= -->

      <div class="recurring-section">

        <div class="recurring-header">

          <div class="recurring-title">

            <i class="fa-solid fa-repeat"></i>

            <span>
              Tagihan Berulang
            </span>

          </div>


          <label class="switch">

            <input
              type="checkbox"
              name="isRecurring"
              id="isRecurring"
            >

            <span class="slider"></span>

          </label>


          <div
            class="recurring-month"
            id="recurringMonthContainer"
          >

            <span>
              Sebanyak
            </span>

            <input
              type="number"
              name="recurringMonths"
              id="recurringMonths"
              min="1"
              placeholder="0"
            >

            <span>
              Bulan
            </span>

          </div>

        </div>


        <div
          class="recurring-info"
          id="recurringInfo"
        >

          <i class="fa-solid fa-circle-info"></i>

          <span>
            Aktifkan fitur ini jika tagihan akan berulang secara berkala.
            Masukkan Berapa Bulan Perulangan, Reminder akan berhenti
            otomatis saat kondisi terpenuhi.
          </span>

        </div>

      </div>


      <!-- DESKRIPSI -->

      <div class="form-group">

        <label for="description">
          Deskripsi / Catatan
        </label>

        <textarea
          id="description"
          name="description"
          rows="4"
          placeholder="Tambahkan Catatan (Opsional)"
        ></textarea>

      </div>

    </div>


    <!-- ================================================= -->
    <!-- KANAN : UPLOAD TAGIHAN -->
    <!-- ================================================= -->

    <div class="bill-upload card">

      <div class="upload-title-row">

        <h2 class="section-title">

          <i class="fa-solid fa-cloud-arrow-up"></i>

          Upload Tagihan

        </h2>


        <!-- AI TOGGLE -->

        <label class="ai-switch">

          <span>
            Isi Otomatis
          </span>

          <input
            type="checkbox"
            id="useAI"
          >

          <span class="slider"></span>

        </label>

      </div>


      <!-- UPLOAD AREA -->

      <div
        class="upload-area"
        id="uploadArea"
      >

        <i class="fa-regular fa-file-lines upload-icon"></i>

        <p>
          Drag & Drop File Tagihan Disini
        </p>

        <span class="upload-or">
          Atau
        </span>


        <label class="btn-upload">

          Pilih File

          <input
            type="file"
            name="invoiceFile"
            id="invoiceFile"
            accept=".pdf,.png,.jpg,.jpeg"
            hidden
          >

        </label>


        <small>
          Format yang didukung : PDF, PNG, JPG<br>
          Maksimal ukuran File 10MB
        </small>

      </div>

      <!-- AI PROCESS CARD -->
      <div id="aiProcessCard" class="ai-process-card hidden">
        <div class="ai-process-header">
          <div class="ai-icon">
            <i class="fa-solid fa-robot"></i>
          </div>

          <div>
            <h3 id="aiProcessTitle">
              AI Isi Otomatis
            </h3>

            <p id="aiProcessStatus">
              Menyiapkan proses...
            </p>
          </div>
        </div>

        <div class="ai-process-body">
          <!-- LOADING -->
           <div class="ai-spinner" id="aiSpinner">
            <i class="fa-solid fa-spinner fa-spin"></i>
           </div>

          <!-- SUCCESS -->
          <div class="ai-check" id="aiCheck">
            <i class="fa-solid fa-circle-check"></i>
          </div>

          <!-- ERROR -->
           <div class="ai-error" id="aiError">
            <i class="fa-solid fa-circle-exclamation"></i>
           </div>

          <div class="ai-process-text">
            <strong id="aiProcessMessage">
              AI sedang memproses invoice...
            </strong>

            <span id="aiProcessDetail">
              Mohon tunggu sebentar.
            </span>
          </div>
        </div>

        <div class="ai-process-file">
          <i class="fa-solid fa-file-pdf"></i>
          <span id="aiProcessFile">
            -
          </span>
        </div>
      </div>

      <!-- PREVIEW -->

      <h2 class="preview-title">
        Preview Tagihan
      </h2>


      <div
        class="invoice-preview"
        id="invoicePreview"
      >

        <div class="preview-empty">

          <i class="fa-regular fa-file-lines"></i>

          <p>
            Belum ada file yang dipilih
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- BOTTOM ACTION -->
  <!-- ================================================= -->

  <div class="bottom-actions">

    <a
      href="/bills"
      class="btn-back"
    >

      <i class="fa-solid fa-arrow-left"></i>

      Kembali

    </a>


    <div class="action-right">

      <button
        type="reset"
        class="btn-reset"
      >
        Reset
      </button>


      <button
        type="submit"
        class="btn-save"
      >

        <i class="fa-regular fa-floppy-disk"></i>

        Simpan Tagihan

      </button>

    </div>

  </div>

</form>



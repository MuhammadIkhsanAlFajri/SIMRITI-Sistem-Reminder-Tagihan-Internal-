<script>

document.addEventListener("DOMContentLoaded", () => {

  /* =================================================
   AI ISI OTOMATIS
================================================= */

const aiToggle =
  document.getElementById("useAI");

const fileInput =
    document.getElementById(
      "invoiceFile"
    );


/* ================================================
   KETIKA TOGGLE DIUBAH
================================================ */

aiToggle.addEventListener("change", async () => {
  if (aiToggle.checked) {
    console.log(
      "AI Isi Otomatis: AKTIF"
    );

    const file = fileInput.file[0];

    if (file) {
      showAIProcessCard(file.name);

      setAIProcessStatus(
        "AI sedang membaca invoice...",
        "Dokumensedang dianalisis. Mohon tunggu."
      );

      let aiSuccess = false;

      try {
        await processInvoiceAI(file);

        aiSuccess = true;

      } catch (error) {
        console.error(
          "ERROR PROSES AI:",
          error
        );

        setAIProcessError(
          error.message
        );
      }
      if (aiSuccess) {
        setAIProcessSuccess();
      }
    }

  } else {
    console.log(
      "AI Isi Otomatis: NONAKTIF"
    );
  }
});


/* ================================================
   FUNGSI PROSES AI
================================================ */

function isValidText(value) {

  if (!value) return false;

  const text = String(value).trim();

  if (text.length < 2) {
    return false;
  }

  const invalidValues = [
    "invoice",
    "in voice",
    "unknown",
    "null",
    "undefined",
    "-"
  ];

  if (
    invalidValues.includes(
      text.toLowerCase()
    )
  ) {
    return false;
  }

  return true;

}

async function processInvoiceAI(file) {

  try {

    console.log("================================");
    console.log("MEMPROSES INVOICE DENGAN AI...");
    console.log("File:", file.name);
    console.log("================================");


    const formData = new FormData();

    /*
      WAJIB "file"

      karena route:
      uploadOCR.single("file")
    */

    formData.append("file", file);


    const response = await fetch(
      "/bills/scan",
      {
        method: "POST",
        body: formData
      }
    );


    console.log(
      "Status Response:",
      response.status
    );


    const result =
      await response.json();


    console.log(
      "HASIL AI:",
      result
    );


    if (!response.ok) {

      throw new Error(
        result.message ||
        "Gagal memproses invoice."
      );

    }


    /*
      PENTING

      Tampilkan struktur data
      dari AI
    */

    console.log(
      "DATA OCR:",
      JSON.stringify(
        result,
        null,
        2
      )
    );


    /* =============================================
       AMBIL DATA

       Mendukung beberapa kemungkinan
       struktur response
    ============================================= */

    const data =
      result.data ||
      result.result ||
      result;


    /* =============================================
       JUDUL TAGIHAN
    ============================================= */

    if (

  data.title ||

  data.judul ||

  data.invoice_title ||

  data.invoice_name

) {


  document.getElementById(
    "title"
  ).value =


    data.title ||

    data.judul ||

    data.invoice_title ||

    data.invoice_name ||

    "";


}


    /* =============================================
       NOMOR INVOICE
    ============================================= */

    const invoiceNumber =
  data.invoiceNumber ||
  data.invoice_number ||
  data.invoice ||
  data.nomorInvoice ||
  "";

if (isValidText(invoiceNumber)) {

  document.getElementById(
    "invoiceNumber"
  ).value =
    invoiceNumber;

}


    /* =============================================
       VENDOR
    ============================================= */

    const vendor =
  data.vendor ||
  data.vendorName ||
  data.company ||
  data.perusahaan ||
  "";

if (isValidText(vendor)) {

  document.getElementById(
    "vendorName"
  ).value = vendor;

} else {

  console.warn(
    "Vendor dari AI tidak valid:",
    vendor
  );

}


    /* =============================================
       NOMINAL
    ============================================= */

    /* =============================================
   NOMINAL
============================================= */

if (

  data.amount !== undefined &&

  data.amount !== null &&

  data.amount !== ""

) {


  document.getElementById(
    "amount"
  ).value =

    String(
      data.amount
    ).replace(
      /[^0-9]/g,
      ""
    );


}
    /* =============================================
       TANGGAL TAGIHAN
    ============================================= */

    if (
      data.invoiceDate ||
      data.invoice_date ||
      data.date ||
      data.tanggalTagihan
    ) {

      document.getElementById(
        "invoiceDate"
      ).value =
        formatDateForInput(
          data.invoiceDate ||
          data.invoice_date ||
          data.date ||
          data.tanggalTagihan
        );

    }


    /* =============================================
       TANGGAL JATUH TEMPO
    ============================================= */

    if (
      data.dueDate ||
      data.due_date ||
      data.deadline ||
      data.jatuhTempo
    ) {

      document.getElementById(
        "dueDate"
      ).value =
        formatDateForInput(
          data.dueDate ||
          data.due_date ||
          data.deadline ||
          data.jatuhTempo
        );

    }


    /* =============================================
       DESKRIPSI
    ============================================= */

    if (
      data.description ||
      data.deskripsi ||
      data.notes
    ) {

      document.getElementById(
        "description"
      ).value =
        data.description ||
        data.deskripsi ||
        data.notes ||
        "";

    }


    console.log("================================");
    console.log("FIELD BERHASIL DIISI AI");
    console.log("================================");


  } catch (error) {

    console.error(
      "ERROR AI:",
      error
    );

    throw error;

  }

}


/* ================================================
   FORMAT TANGGAL UNTUK INPUT TYPE DATE

   Hasil:
   YYYY-MM-DD
================================================ */

function formatDateForInput(dateValue) {

  if (!dateValue) {
    return "";
  }


  /*
    Jika sudah YYYY-MM-DD
  */

  if (
    /^\d{4}-\d{2}-\d{2}$/.test(
      dateValue
    )
  ) {

    return dateValue;

  }


  const date =
    new Date(dateValue);


  if (
    isNaN(date.getTime())
  ) {

    console.warn(
      "Format tanggal tidak dikenali:",
      dateValue
    );

    return "";

  }


  const year =
    date.getFullYear();


  const month =
    String(
      date.getMonth() + 1
    ).padStart(2, "0");


  const day =
    String(
      date.getDate()
    ).padStart(2, "0");


  return `${year}-${month}-${day}`;

}

  /* =================================================
     DEFAULT TANGGAL HARI INI
  ================================================= */

  const invoiceDate =
    document.getElementById("invoiceDate");

  if (!invoiceDate.value) {

    const today = new Date();

    const year = today.getFullYear();

    const month = String(
      today.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
      today.getDate()
    ).padStart(2, "0");

    invoiceDate.value =
      `${year}-${month}-${day}`;

  }


  /* =================================================
     RECURRING TOGGLE
  ================================================= */

  const recurringToggle =
    document.getElementById("isRecurring");

  const recurringMonth =
    document.getElementById(
      "recurringMonthContainer"
    );

  const recurringMonths =
    document.getElementById(
      "recurringMonths"
    );

  const recurringInfo =
    document.getElementById(
      "recurringInfo"
    );


  function updateRecurring() {

    if (recurringToggle.checked) {

      recurringMonth.style.display =
        "flex";

      recurringInfo.style.display =
        "flex";

      recurringMonths.required =
        true;

    } else {

      recurringMonth.style.display =
        "none";

      recurringInfo.style.display =
        "none";

      recurringMonths.required =
        false;

      recurringMonths.value = "";

    }

  }


  recurringToggle.addEventListener(
    "change",
    updateRecurring
  );


  updateRecurring();

  /* =================================================
   AI PROCESS CARD
  ================================================= */

  function showAIProcessCard(fileName) {
    const card = document.getElementById("aiProcessCard");
    const title = document.getElementById("aiProcessTitle");
    const status = document.getElementById("aiProcessStatus");
    const message = document.getElementById("aiProcessMessage");
    const detail = document.getElementById("aiProcessDetail");
    const file = document.getElementById("aiProcessFile");
    const spinner = document.getElementById("aiSpinner");
    const check = document.getElementById("aiCheck");
    const error = document.getElementById("aiError");

    /* TAMPILKAN CARD */
    card.classList.remove("hidden");

    // RESET STATUS
    title.textContent = "AI Isi Otomatis";
    status.textContent = "Sedang diproses...";
    message.textContent = "AI sedang memproses invoice...";
    detail.textContent = "Mohon tunggu sebentar.";
    file.textContent = fileName;

    // TSMPILKAN LOADING
    spinner.style.display = "flex";
    check.style.display = "none";
    error.style.display = "none";
  }

  /* =================================================
   UPDATE STATUS
  ================================================= */

  function setAIProcessStatus(
    messageText,
    detailText
  ) {
    document.getElementById(
      "aiProcessMessage"
    ).textContent = messageText;

    document.getElementById(
      "aiProcessDetail"
    ).textContent = detailText;
  }

  /* =================================================
   AI BERHASIL
  ================================================= */
  function setAIProcessSuccess() {
    document.getElementById(
      "aiProcessTitle"
    ).textContent = "AI Isi Otomatis";

    document.getElementById(
      "aiProcessStatus"
    ).textContent = "Selesai";

    document.getElementById(
      "aiProcessMessage"
    ).textContent = "Invoice berhasil dianalisis";

    document.getElementById(
      "aiProcessDetail"
    ).textContent = "Data invoice berhasil dimasukkan ke form.";

    document.getElementById(
      "aiSpinner"
    ).style.display = "none";

    documnet.getElementById(
      "aiCheck"
    ).style.display = "flex";

    document.getElementById(
      "aiError"
    ).style.display = "none";
  }

  /* =================================================
      AI GAGAL
  ================================================= */
  function setAIProcessError(messageText) {
    document.getElementById(
      "aiProcessTitle"
    ).textContent = "AI Isi Otomatis";

    document.getElementById(
      "aiProcessStatus"
    ).textContent = "Gagal";

    document.getElementById(
      "aiProcessMessage"
    ).textContent = "AI gagal memproses invoice";

    document.getElementById(
      "aiProcessDetail"
    ).textContent = messageText || "Terjadi kesalahan saat membaca invoice.";

    documnet.getElementById(
      "aiSpinner"
    ).style.display = "none";

    document.getElementById(
      "aiCheck"
    ).style.display = "none";

    document.getElementById(
      "aiError"
    ).style.display = "flex";
  }

  /* =================================================
     FILE PREVIEW
  ================================================= */

  // const fileInput =
  //   document.getElementById(
  //     "invoiceFile"
  //   );

  const preview =
    document.getElementById(
      "invoicePreview"
    );


  fileInput.addEventListener(
    "change",
    async () => {

      const file =
        fileInput.files[0];


      if (!file) {

        preview.innerHTML = `

          <div class="preview-empty">

            <i class="fa-regular fa-file-lines"></i>

            <p>
              Belum ada file yang dipilih
            </p>

          </div>

        `;

        return;

      }


      /* BATAS 10 MB */

      const maxSize =
        10 * 1024 * 1024;


      if (file.size > maxSize) {

        alert(
          "Ukuran file maksimal 10MB."
        );

        fileInput.value = "";

        return;

      }


      const fileURL =
        URL.createObjectURL(file);


      /* PDF */

      if (
        file.type ===
        "application/pdf"
      ) {

        preview.innerHTML = `

          <iframe
            src="${fileURL}"
            width="100%"
            height="100%"
            style="border:none;"
          ></iframe>

        `;

      }


      /* IMAGE */

      else if (
        file.type.startsWith("image/")
      ) {

        preview.innerHTML = `

          <img
            src="${fileURL}"
            style="
              width:100%;
              height:100%;
              object-fit:contain;
            "
          >

        `;

      }

      /* =============================================
        JIKA AI AKTIF

        LANGSUNG PROSES FILE
      ============================================= */

      if (aiToggle.checked) {

        showAIProcessCard(file.name);

        setAIProcessStatus(
          "AI sedang membaca invoice...",
          "Dokumen sedang dianalisis. Mohon tunggu."
        );

        let aiSuccess = false;

        try {
          
          await processInvoiceAI(file);

          aiSuccess = true;

        } catch (error) {

          console.error(
            "ERRor PROSES AI:",
            error
          );

          setAIProcessError(
            error.message
          );
        }

        if (aiSuccess) {
          setAIProcessSuccess();
        }
      }

    }
  );

});



</script>
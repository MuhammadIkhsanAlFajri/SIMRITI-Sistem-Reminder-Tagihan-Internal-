<div class="page-header">

  <h1>Edit Tagihan</h1>

  <p>
    Dashboard / Data Tagihan / Edit Tagihan
  </p>

</div>


<form
  action="/bills/<%= bill.id %>/edit"
  method="POST"
  enctype="multipart/form-data"
  id="billForm"
>

<div class="create-grid">

  <!-- ================================================= -->
  <!-- KIRI -->
  <!-- ================================================= -->

  <div class="left">

    <div class="card">

      <h2>
        <i class="fa-solid fa-list-check"></i>
        Informasi Tagihan
      </h2>


      <!-- ========================= -->
      <!-- JUDUL -->
      <!-- ========================= -->

      <div class="form-group">

        <label for="title">
          Judul Tagihan
        </label>

        <input
          id="title"
          name="title"
          type="text"
          value="<%= bill.title %>"
          placeholder="Contoh : Listrik, Internet, Sewa Gedung"
          required
        >

      </div>


      <!-- ========================= -->
      <!-- NOMOR INVOICE -->
      <!-- ========================= -->

      <div class="form-group">

        <label for="invoiceNumber">
          Nomor Tagihan
        </label>

        <input
          id="invoiceNumber"
          name="invoiceNumber"
          type="text"
          value="<%= bill.invoiceNumber || '' %>"
          placeholder="Isi Nomor Invoice yang tertera pada tagihan"
        >

      </div>


      <!-- ========================= -->
      <!-- VENDOR -->
      <!-- ========================= -->

      <div class="form-group">

        <label for="vendorName">
          Vendor
        </label>

        <input
          id="vendorName"
          name="vendorName"
          type="text"
          value="<%= bill.vendor ? bill.vendor.name : '' %>"
          list="vendorList"
          placeholder="Masukkan atau pilih vendor"
          required
        >

        <datalist id="vendorList">

          <% if (typeof vendors !== "undefined" && vendors.length) { %>

            <% vendors.forEach(vendor => { %>

              <option value="<%= vendor.name %>"></option>

            <% }) %>

          <% } %>

        </datalist>

      </div>


      <!-- ========================= -->
      <!-- TOTAL BIAYA -->
      <!-- ========================= -->

      <div class="form-group">

        <label for="amount">
          Total Biaya
        </label>

        <input
          id="amount"
          type="number"
          name="amount"
          min="0"
          step="0.01"
          value="<%= bill.amount ?? '' %>"
          placeholder="Opsional"
        >

      </div>


      <!-- ========================= -->
      <!-- TANGGAL -->
      <!-- ========================= -->

      <div class="row">

        <div class="form-group">

          <label for="invoiceDate">
            Tanggal Tagihan
          </label>

          <input
            id="invoiceDate"
            type="date"
            name="invoiceDate"
            value="<%= bill.invoiceDate.toISOString().split('T')[0] %>"
            required
          >

        </div>


        <div class="form-group">

          <label for="dueDate">
            Tenggat Tagihan
          </label>

          <input
            id="dueDate"
            type="date"
            name="dueDate"
            value="<%= bill.dueDate.toISOString().split('T')[0] %>"
            required
          >

        </div>

      </div>


      <!-- ================================================= -->
      <!-- TAGIHAN BERULANG -->
      <!-- ================================================= -->

      <div class="recurring-section">

        <div class="recurring-header">

          <div>
            <strong>Tagihan Berulang</strong>

            <p class="recurring-description">
              Aktifkan jika tagihan ini akan berulang.
            </p>
          </div>

          <label class="switch">

          <input
            type="checkbox"
            id="recurringToggle"
            name="isRecurring"
            <% if (bill.type === "BERULANG") { %>
              checked
            <% } %>
          >

          <span class="slider"></span>

        </label>

      </div>


      <!-- OPSI BERULANG -->

      <div
        id="recurringOptions"
        class="recurring-options"
      >

        <div class="form-group">

          <label for="recurringMonths">
            Batas Tagihan (Bulan)
          </label>

          <input
            id="recurringMonths"
            type="number"
            name="recurringMonths"
            value="<%= bill.recurringMonths ?? 0 %>"
            min="0"
            step="1"
          >

          <small>
            Isi 0 jika tagihan berulang tanpa batas.
          </small>

        </div>

      </div>

    </div>


      <!-- ========================= -->
      <!-- DESKRIPSI -->
      <!-- ========================= -->

      <div class="form-group">

        <label for="description">
          Deskripsi
        </label>

        <textarea
          id="description"
          name="description"
          placeholder="Tambahkan catatan (Opsional)"
        ><%= bill.description || "" %></textarea>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- KANAN -->
  <!-- ================================================= -->

  <div class="right">


    <!-- ========================= -->
    <!-- UPLOAD -->
    <!-- ========================= -->

    <div class="card">

      <div
        style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          margin-bottom:20px;
        "
      >

        <h2 style="margin:0;">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          Upload Tagihan
        </h2>


        <div
          style="
            display:flex;
            align-items:center;
            gap:10px;
          "
        >

          <strong>
            Isi Otomatis
          </strong>

          <label class="switch">

            <input
              type="checkbox"
              id="autoFillToggle"
            >

            <span class="slider"></span>

          </label>

        </div>

      </div>


      <!-- UPLOAD BOX -->

      <label
        for="invoiceFile"
        class="upload-box"
        id="uploadBox"
      >

        <div class="upload-icon">
          <i class="fa-regular fa-file-lines"></i>
        </div>


        <div class="upload-text">

          <strong>
            Drag & Drop File Tagihan Disini
          </strong>

          <span>
            Atau
          </span>

        </div>


        <span class="btn-upload">
          Pilih File
        </span>


        <p>
          Format yang didukung : PDF, PNG, JPG<br>
          Maksimal ukuran File 10MB
        </p>

      </label>


      <input
        type="file"
        id="invoiceFile"
        name="invoiceFile"
        accept=".pdf,.png,.jpg,.jpeg"
        hidden
      >

    </div>


    <!-- ========================= -->
    <!-- PREVIEW -->
    <!-- ========================= -->

    <div class="card">

      <h2>
        Preview Tagihan
      </h2>


      <div
        id="preview"
        class="preview-box"
      >

        <% if (bill.invoiceFile) { %>

          <iframe
            src="/uploads/invoice/<%= bill.invoiceFile %>"
            style="
              width:100%;
              height:100%;
              border:none;
              border-radius:10px;
            "
          ></iframe>

        <% } else { %>

          <div class="preview-empty">

            <i class="fa-regular fa-file-lines"></i>

            <span>
              Belum ada file yang dipilih
            </span>

          </div>

        <% } %>

      </div>

    </div>

  </div>

</div>


<!-- ================================================= -->
<!-- BUTTON -->
<!-- ================================================= -->

<div class="button-group">

  <a
    href="/bills/<%= bill.id %>"
    class="btn-back"
    onclick="goBack(event)"
  >
    <i class="fa-solid fa-arrow-left"></i>
    Kembali
  </a>

  


  <button
    type="submit"
    class="btn-save"
  >
    Update Tagihan
  </button>

</div>

</form>


<script>

/* =====================================================
   TAGIHAN BERULANG
===================================================== */

const recurringToggle =
  document.getElementById("recurringToggle");

const recurringOptions =
  document.getElementById("recurringOptions");

const recurringMonths =
  document.getElementById("recurringMonths");


function updateRecurringDisplay() {

  if (!recurringToggle) {
    return;
  }

  if (recurringToggle.checked) {

    recurringOptions.style.display = "block";

    recurringMonths.disabled = false;

    if (recurringMonths.value === "") {
      recurringMonths.value = 0;
    }

  } else {

    recurringOptions.style.display = "none";

    recurringMonths.disabled = true;

  }

}


/* Jalankan saat halaman pertama kali dibuka */

updateRecurringDisplay();


/* Jalankan ketika toggle berubah */

if (recurringToggle) {

  recurringToggle.addEventListener(
    "change",
    updateRecurringDisplay
  );

}


/* =====================================================
   PREVIEW FILE
===================================================== */

const fileInput =
  document.getElementById("invoiceFile");

const preview =
  document.getElementById("preview");

const uploadBox =
  document.getElementById("uploadBox");


fileInput.addEventListener("change", function () {

  const file = this.files[0];

  if (!file) {

    return;

  }


  /* =========================
     CEK UKURAN
  ========================= */

  if (file.size > 10 * 1024 * 1024) {

    alert("Ukuran maksimal file adalah 10MB.");

    fileInput.value = "";

    return;

  }


  /* =========================
     PREVIEW
  ========================= */

  preview.innerHTML = "";


  /* IMAGE */

  if (file.type.startsWith("image/")) {

    const img =
      document.createElement("img");

    img.src =
      URL.createObjectURL(file);

    img.style.width = "100%";

    img.style.height = "100%";

    img.style.objectFit = "contain";

    img.style.borderRadius = "10px";

    preview.appendChild(img);

  }


  /* PDF */

  else if (
    file.type === "application/pdf"
  ) {

    const iframe =
      document.createElement("iframe");

    iframe.src =
      URL.createObjectURL(file);

    iframe.style.width = "100%";

    iframe.style.height = "100%";

    iframe.style.border = "none";

    iframe.style.borderRadius = "10px";

    preview.appendChild(iframe);

  }


  else {

    preview.innerHTML = `
      <div class="preview-empty">
        <i class="fa-regular fa-file-lines"></i>
        <span>${file.name}</span>
      </div>
    `;

  }

});


/* =====================================================
   DRAG & DROP
===================================================== */

uploadBox.addEventListener("dragover", function (e) {

  e.preventDefault();

  uploadBox.classList.add("dragging");

});


uploadBox.addEventListener("dragleave", function () {

  uploadBox.classList.remove("dragging");

});


uploadBox.addEventListener("drop", function (e) {

  e.preventDefault();

  uploadBox.classList.remove("dragging");

  const files = e.dataTransfer.files;

  if (!files.length) {
    return;
  }

  fileInput.files = files;

  fileInput.dispatchEvent(
    new Event("change")
  );

});

/* =====================================================
   TOMBOL KEMBALI
===================================================== */
function goBack(event) {
      if (document.referrer) {
        event.preventDefault();
        window.history.back();
      }
    }

</script>
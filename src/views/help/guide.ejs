     10 LOGOUT
================================ -->

<div class="guide-section">
  <div class="guide-number">09</div>

  <div class="guide-content">
    <h2>Log Out</h2>

    <p>
      Setelah selesai menggunakan aplikasi, klik menu
      <strong>Log Out</strong> pada sidebar untuk keluar dari sistem.
    </p>
  </div>
